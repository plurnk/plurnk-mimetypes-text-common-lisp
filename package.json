{
    "name": "@plurnk/plurnk-mimetypes-text-common-lisp",
    "version": "1.0.8",
    "description": "text/x-common-lisp mimetype handler for plurnk-service. Hand-rolled S-expression scanner (no ANTLR).",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26"
    },
    "plurnk": {
        "kind": "mimetype",
        "handlers": [
            {
                "name": "text/x-common-lisp",
                "glyph": "λ",
                "extensions": [
                    ".lisp",
                    ".lsp",
                    ".cl",
                    ".asd"
                ]
            }
        ]
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "node --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:dist",
        "prepare": "npm run build && (git config core.hooksPath .githooks || true)",
        "deps:fresh": "npm outdated",
        "prepublishOnly": "npm run deps:fresh && npm audit --audit-level=moderate && npm test"
    },
    "devDependencies": {
        "@plurnk/plurnk-mimetypes": "1.0.8",
        "@types/node": "^26.0.0",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes": "1.0.8"
    }
}
